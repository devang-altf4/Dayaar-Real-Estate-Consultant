# Application
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/dayaar_crm
CORS_ORIGIN=http://localhost:3000

# Authentication - use independent, high-entropy values
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Web build/runtime
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Destructive local seed. Never enable in production.
ALLOW_DESTRUCTIVE_SEED=false

# Calling policy
MIN_REDIAL_GAP_SECONDS=180
BACKGROUND_JOBS_ENABLED=true

# Lets an external scheduler (e.g. a platform cron job) drive reconciliation,
# archival and retention by POSTing to /api/integrations/maintenance/run with
# this value in an x-maintenance-secret header. Required where the instance
# sleeps or scales to zero and the in-process interval cannot be relied on.
MAINTENANCE_TRIGGER_SECRET=

# Callyzer capture and reconciliation. Keep disabled until real credentials exist.
CALLYZER_INTEGRATION_ENABLED=false
CALLYZER_BASE_URL=https://api1.callyzer.co/api/v2.2
CALLYZER_API_TOKEN=
CALLYZER_WEBHOOK_SECRET=
CALLYZER_ORGANIZATION_ID=
CALLYZER_TIMEZONE_OFFSET=+05:30

# Firebase Cloud Messaging HTTP v1 service account
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Preserve escaped newlines when stored as one environment value.
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Backblaze B2 S3-compatible primary recording archive.
# Keep disabled until B2 and Callyzer integration credentials are configured.
#
# While this is false there is no durable archive, so recordings are stored
# on-host only and the provider's copy is deliberately RETAINED rather than
# deleted. Set it to true (with the B2 values below) to enable provider-side
# cleanup, signed playback URLs and export purging. In production the API
# refuses to start if this is true but B2 is not fully configured.
RECORDING_STORAGE_ENABLED=false
B2_S3_ENDPOINT=https://s3.REGION.backblazeb2.com
B2_S3_REGION=REGION
B2_BUCKET=dayaar-crm-recordings
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Independent VPS disaster-recovery copy. Use durable storage in deployment.
# On an ephemeral filesystem (containers, Render) this path does NOT survive a
# redeploy and is never treated as a durable archive.
VPS_RECORDING_BACKUP_PATH=./data/recording-backup

# Recording exports are assembled in memory; peak heap is roughly twice this.
# Keep it comfortably below the instance memory limit.
RECORDING_EXPORT_MAX_BYTES=100663296
